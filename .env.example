# Copy to .env.local for local runs (never committed). On Vercel, set these in
# Project → Settings → Environment Variables instead. Leave both Supabase values
# empty to run in demo mode.

# Supabase → Connect button. Looks like https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Supabase → Project Settings → API Keys → publishable key (sb_publishable_…).
# NEVER the secret key (sb_secret_…) or service_role key: the build refuses them.
SUPABASE_PUBLISHABLE_KEY=

# The site's address, e.g. https://rioandolivia.com. Used for invite links and the
# WhatsApp preview image. Optional on Vercel (falls back to the production domain).
SITE_URL=

# Admin signs in as "kaybidut"; this domain makes it kaybidut@example.com
ADMIN_EMAIL_DOMAIN=example.com
